{
  "name": "notebook-cleaner",
  "displayName": "%extension.displayName%",
  "publisher": "stanaka",
  "description": "%extension.description%",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stanaka2/notebook_cleaner.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Notebooks",
    "Other"
  ],
  "keywords": [
    "jupyter",
    "notebook",
    "ipynb",
    "outputs",
    "clean"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onCommand:notebookCleaner.clearOutputs",
    "onCommand:notebookCleaner.removeEmptyCells",
    "onCommand:notebookCleaner.cleanNotebook"
  ],
  "contributes": {
    "commands": [
      {
        "command": "notebookCleaner.clearOutputs",
        "title": "%command.clearOutputs.title%",
        "category": "%command.category%"
      },
      {
        "command": "notebookCleaner.removeEmptyCells",
        "title": "%command.removeEmptyCells.title%",
        "category": "%command.category%"
      },
      {
        "command": "notebookCleaner.cleanNotebook",
        "title": "%command.cleanNotebook.title%",
        "category": "%command.category%"
      }
    ],
    "submenus": [
      {
        "id": "notebookCleaner.context",
        "label": "%submenu.label%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "notebookCleaner.context",
          "when": "resourceExtname == .ipynb || explorerResourceIsFolder",
          "group": "notebookCleaner"
        }
      ],
      "notebookCleaner.context": [
        {
          "command": "notebookCleaner.clearOutputs",
          "group": "1_actions@1"
        },
        {
          "command": "notebookCleaner.removeEmptyCells",
          "group": "1_actions@2"
        },
        {
          "command": "notebookCleaner.cleanNotebook",
          "group": "1_actions@3"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "notebookCleaner.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.venv/**",
            "**/venv/**",
            "**/node_modules/**"
          ],
          "description": "%configuration.exclude.description%",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check lib/notebook.js && node --check lib/targets.js",
    "package": "npx @vscode/vsce package"
  }
}
